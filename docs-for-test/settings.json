{
  "$schema": "https://mdsvr.js.org/schema/v2.json",
  "site": {
    "title": "MDSVR | Markdown Documentation Server",
    "description": "Full-featured documentation website server with MDX support, site settings, SEO, and navigation",
    "language": "en"
  },
  "appearance": {
    "defaultTheme": "system",
    "allowThemeToggle": true,
    "accentColor": "#0969da",
    "codeTheme": {
      "light": "github",
      "dark": "github-dark"
    }
  },
  "navigation": {
    "sidebar": {
      "enabled": true,
      "autoGenerate": true,
      "depth": 3,
      "docsOnly": true,
      "collapsible": true,
      "defaultOpen": true
    },
    "tocEnabled": true
  },
  "search": {
    "enabled": true,
    "placeholder": "Search documentation...",
    "maxResults": 10
  },
  "seo": {
    "generateSitemap": true,
    "generateRssFeed": false,
    "og": {
      "enabled": true,
      "imageFormat": "jpg",
      "generateOnServe": false
    }
  },
  "mdx": {
    "enabled": true
  }
}
